# Copy to /opt/api/.env on the server. Never commit the real file.
APP_ENV=prod
# Tables come from migrations in production (the container runs them on start).
DB_SYNCHRONIZE=false
BOOKING_IMAGE=ghcr.io/austial/api-booking:latest

# Managed Postgres connection string, asyncpg driver.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:25060/defaultdb?ssl=require

SITE_URL=https://services.austial.com
CORS_ORIGINS=https://services.austial.com
TRUSTED_PROXY_HOPS=1
# Long random string. Changing it invalidates open codes and every manage link.
CODE_PEPPER=
# Bearer token for the read-only /v1/admin/leads and /v1/admin/bookings routes. Leave empty to disable them.
ADMIN_TOKEN=

# Email through Amazon SES. MAIL_FROM must be a verified identity.
MAIL_BACKEND=ses
MAIL_FROM=Austial <info@austial.com>
MAIL_NOTIFY_TO=info@austial.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Calendar and Meet (see the README for the one-time token).
CALENDAR_BACKEND=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
